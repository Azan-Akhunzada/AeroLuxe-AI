{
  "name": "aeroluxe-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AeroLuxe AI — a luxury-tier autonomous flight search & deals agent (React + Tailwind + Express).",
  "keywords": ["flight-search", "travel", "react", "tailwind", "express", "deals-agent"],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prod": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
