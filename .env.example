# ---------------------------------------------------------------------------
# AeroLuxe AI — environment configuration
# Copy this file to `.env` and adjust. Every value is optional: with an empty
# .env the app runs fully in MOCK mode and every feature is demonstrable.
# ---------------------------------------------------------------------------

# Express agent server port
PORT=8787

# Front-end dev server port (vite)
VITE_PORT=5173

# --- Live scraping layer (optional) ----------------------------------------
# Set to "true" AND provide a Firecrawl key to attempt real web extraction of
# budget flight engines (Skyscanner, Google Flights, Kayak, Kiwi, Momondo,
# CheapoAir). Without these, AeroLuxe AI uses its deterministic MockProvider —
# the same response shape, so the UI is identical.
USE_LIVE_SEARCH=false
FIRECRAWL_API_KEY=

# Request timeout (ms) for each live provider scrape
SCRAPE_TIMEOUT_MS=20000

# --- Price alerts ----------------------------------------------------------
# A background sweep that checks saved alerts. Enabled in-memory by default.
ALERTS_POLL_MINUTES=30
